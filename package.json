{
  "name": "liendeadline-mcp",
  "version": "0.1.0",
  "description": "MCP server for US mechanics lien and preliminary notice deadlines. Calculates statutory deadlines for all 50 states plus DC from an invoice date, and exposes the underlying state rules with statute citations.",
  "type": "module",
  "bin": { "liendeadline-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js"
  },
  "keywords": ["mcp", "model-context-protocol", "mechanics-lien", "construction", "deadlines", "lien", "preliminary-notice"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
