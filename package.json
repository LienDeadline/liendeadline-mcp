{
  "name": "liendeadline-mcp",
  "version": "0.3.1",
  "description": "MCP server for US mechanics lien and preliminary notice deadlines. Public supplier delivery-event baselines (reviewed for Florida and Kansas private projects) and statute-cited lien guides for all 50 states plus DC.",
  "type": "module",
  "bin": {
    "liendeadline-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mechanics-lien",
    "construction",
    "deadlines",
    "lien",
    "preliminary-notice",
    "notice-to-owner",
    "supplier",
    "mcp-server"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "mcpName": "io.github.LienDeadline/liendeadline-mcp",
  "homepage": "https://liendeadline.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LienDeadline/liendeadline-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/LienDeadline/liendeadline-mcp/issues"
  },
  "author": {
    "name": "LienDeadline",
    "url": "https://liendeadline.com"
  }
}
