{
  "name": "liendeadline-mcp",
  "version": "0.5.8",
  "description": "Check live project coverage and calculate statute-cited supplier notice and mechanics lien deadlines. Public lien guides cover all 50 states and DC.",
  "type": "module",
  "bin": {
    "liendeadline-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "smoke": "node dist/smoke.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mechanics-lien",
    "lien",
    "lien-deadlines",
    "preliminary-notice",
    "notice-to-owner",
    "construction",
    "construction-law",
    "material-supplier",
    "supplier",
    "deadlines",
    "claude",
    "chatgpt",
    "cursor",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@posthog/mcp": "1.1.1",
    "posthog-node": "5.69.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "mcpName": "io.github.LienDeadline/liendeadline-mcp",
  "homepage": "https://liendeadline.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LienDeadline/liendeadline-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/LienDeadline/liendeadline-mcp/issues",
    "email": "support@liendeadline.com"
  },
  "author": {
    "name": "LienDeadline",
    "url": "https://liendeadline.com"
  }
}
